# Postgres connection string (Neon/Supabase-style). Copy this file to .env
# and fill in your own values.
#
# Neon example:
#   DATABASE_URL="postgresql://<user>:<password>@<project>.neon.tech/<database>?sslmode=require"
# Supabase example:
#   DATABASE_URL="postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres"
DATABASE_URL="postgresql://user:password@host:5432/hauswerk?sslmode=require"

# Restricted, non-owner Postgres role used for all runtime reads/writes
# against tenant-sensitive tables (Tenant, Lease, Payment,
# TenantOffboarding). Row-level security policies (see
# prisma/migrations/*_add_rls_policies) only apply to non-superuser,
# non-table-owner connections, so this must be a separate user/role from
# whatever runs migrations via DATABASE_URL — e.g. a second Neon/Supabase
# role, or `app_runtime` created by the RLS migration on a local database.
RUNTIME_DATABASE_URL="postgresql://app_runtime:password@host:5432/hauswerk?sslmode=require"

# Auth.js (NextAuth v5) session signing secret — generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"

# Resend (https://resend.com) API key for sending statements, invoices and
# letters of demand with a generated PDF attached. Leave empty for local
# dev — lib/email.ts logs the email + attachment to the console instead of
# calling the API when this is unset. onboarding@resend.dev is Resend's
# shared dev-safe sender and needs no domain verification, but can only
# deliver to your own Resend account's email until you verify a domain —
# swap in your own once you do.
RESEND_API_KEY="re_your_api_key"
RESEND_FROM_EMAIL="HAUSWERK <onboarding@resend.dev>"
