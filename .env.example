# Copy to .env and fill in. Every variable the app reads is listed here.
# Production (Supabase + Vercel) values are explained step by step in
# DEPLOY.md. Never commit real values.

# ---- Database ----
# Owner/migration connection. Used by `prisma migrate deploy` AND at
# runtime for the non-tenant-sensitive tables (lib/prisma.ts).
# Supabase: the SESSION pooler (port 5432), user postgres.<project-ref>.
#   DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Local:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/contrarians_properties?schema=public"
DATABASE_URL=""

# Restricted, non-owner role used for every query against tenant-sensitive
# tables (Tenant, Lease, Payment, TenantOffboarding) — row-level security
# only applies to non-owner, non-superuser connections, so this must be a
# different role from DATABASE_URL. Created by the *_add_rls_policies
# migration; its real password is set by prisma/setup-roles.sql.
# Supabase: same session pooler, user app_runtime.<project-ref>.
#   RUNTIME_DATABASE_URL="postgresql://app_runtime.<project-ref>:<app-runtime-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Local:
#   RUNTIME_DATABASE_URL="postgresql://app_runtime:app_runtime_dev_password@localhost:5432/contrarians_properties?schema=public"
RUNTIME_DATABASE_URL=""

# ---- Auth (Auth.js v5) ----
# Session signing secret — generate with: openssl rand -base64 32
AUTH_SECRET=""
# The app's public URL. Optional on Vercel (detected and trusted
# automatically). On any other host a production build rejects every auth
# request ("UntrustedHost") unless AUTH_URL is set or AUTH_TRUST_HOST=true
# — including `next start` on your own machine.
AUTH_URL=""
# AUTH_TRUST_HOST="true"

# ---- Email (Resend) ----
# Leave empty to skip sending: lib/email.ts then logs each email and stores
# its PDF under outbox/ in object storage instead (viewable locally at
# /landlord/dev/outbox). onboarding@resend.dev needs no domain setup but only
# delivers to your own Resend account's address until you verify a domain.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Contrarians Properties <onboarding@resend.dev>"

# ---- File storage (Supabase Storage) ----
# Generated PDFs (offboarding archives, dev outbox) go to this PRIVATE
# bucket. Leave all three empty locally to use the storage/ folder on disk
# instead. Required in production — Vercel's filesystem doesn't persist.
# The key is server-only (never NEXT_PUBLIC_): Supabase dashboard → Project
# Settings → API Keys → secret key (sb_secret_…) or legacy service_role.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="documents"
